GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-2.5-flash

# Movement timing in seconds
MOVE_SEC=0.45
BACKWARD_SEC=0.6
TURN_SEC=1.2
TURN_AROUND_SEC=2.0
OBJECT_SEARCH_TURN_SEC=1.0
OBJECT_ALIGN_TURN_SEC=0.8

# Distance and safety thresholds in centimeters
SAFE_DISTANCE_CM=25
ULTRASONIC_STOP_CM=18
TARGET_STOP_DISTANCE_CM=30
ULTRASONIC_MAX_CM=400
ULTRASONIC_ENABLED=1
ULTRASONIC_TRIG=23
ULTRASONIC_ECHO=24

# Command status LED
COMMAND_LED_PIN=25

# USB camera
CAMERA_INDEX=1
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_JPEG_QUALITY=75

# USB audio input and TTS
AUDIO_DEVICE=plughw:3,0
AUDIO_SAMPLE_RATE=48000
AUDIO_CHUNK_MS=80
AUDIO_MIN_ENERGY=430
AUDIO_NOISE_MULTIPLIER=2.0
AUDIO_DEBUG=0
USE_TTS=1
TTS_VOLUME=0.9
TTS_TIMEOUT_SEC=
TTS_CACHE_DIR=/tmp/robot_tts_cache

# Optional local audio files. This directory is ignored by Git.
MUSIC_DIR=music
