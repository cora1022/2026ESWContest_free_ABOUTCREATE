# Raspberry Pi identity and VPS connection
ROBOT_ID=robot-01
ROBOT_SERVER_URL=wss://181.214.136.80/ws/robot
ROBOT_TOKEN=replace-with-the-token-from-the-vps
REMOTE_ENABLED=1
REMOTE_SEND_TIMEOUT_SEC=5
REMOTE_HANDSHAKE_TIMEOUT_SEC=10
TELEMETRY_INTERVAL_SEC=1.0
REMOTE_DRIVE_LEASE_MS=650

# Gemini is optional. If omitted, Korean rule-based commands still work.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=15000

# Existing L298N movement calibration
MOVE_SEC=0.45
BACKWARD_SEC=0.6
TURN_SEC=0.9
TURN_AROUND_SEC=1.8

# HC-SR04. A timeout stops forward movement by default.
ULTRASONIC_ENABLED=1
ULTRASONIC_TRIG=23
ULTRASONIC_ECHO=24
SAFE_DISTANCE_CM=25
ULTRASONIC_STOP_CM=18
ULTRASONIC_MAX_CM=400
ULTRASONIC_TIMEOUT_IS_CLEAR=0

# Camera and audio
CAMERA_INDEX=0
CAMERA_WIDTH=848
CAMERA_HEIGHT=480
CAMERA_JPEG_QUALITY=75
CAMERA_INPUT_FORMAT=MJPG
CAMERA_INPUT_FPS=30
CAMERA_AUTOFOCUS=1
CAMERA_WARMUP_FRAMES=12
CAMERA_CAPTURE_FLUSH_FRAMES=1
REMOTE_VIDEO_FPS=4
REMOTE_VIDEO_LEASE_MS=8000
REMOTE_VIDEO_JPEG_QUALITY=70
AUDIO_DEVICE=plughw:CARD=CAMERA,DEV=0
AUDIO_OUTPUT_DEVICE=plughw:CARD=UACDemoV10,DEV=0
AUDIO_SAMPLE_RATE=48000
AUDIO_ERROR_BACKOFF_SEC=3
AUDIO_ERROR_LOG_INTERVAL_SEC=15
USE_TTS=1

# Optional gpsd integration
GNSS_ENABLED=0
GPSD_HOST=127.0.0.1
GPSD_PORT=2947
